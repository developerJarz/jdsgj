# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=<your-strong-jwt-secret>

# Brevo Transactional Email (for OTP verification)
BREVO_API_KEY=xsmtpsib-<your-brevo-smtp-key>
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=<your-brevo-smtp-login>
BREVO_FROM_EMAIL=<your-verified-brevo-email>
BREVO_FROM_NAME=Shajgoj.bd

# Application Configuration
NEXT_PUBLIC_SITE_NAME="Shajgoj"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1500
